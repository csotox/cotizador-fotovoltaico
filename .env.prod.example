# Copiar a .env.prod y completar. NO versionar .env.prod

SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=cotizador.example.cl
CSRF_TRUSTED_ORIGINS=https://cotizador.example.cl

# HTTPS lo termina Traefik (Dokploy)
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

POSTGRES_USER=cotizador
POSTGRES_PASSWORD=
POSTGRES_DB=cotizador

GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60

# Opcional: creación automática del superusuario en el primer deploy
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# Opcional: correo
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
